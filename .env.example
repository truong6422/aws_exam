# ─────────────────────────────────────────────────────────────────────────────
# aws-exam-app — environment variable template
# Copy to .env and fill in real values before running docker compose.
# NEVER commit a populated .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
# Generate a strong key with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=change-me-to-a-long-random-string

# "1" for local dev; "0" for staging/production
DEBUG=0

# Comma-separated list of allowed hostnames (production example: myapp.com,www.myapp.com)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Django settings module to load
# Options: config.settings.development | config.settings.production | config.settings.test
DJANGO_SETTINGS_MODULE=config.settings.production

# CORS — comma-separated origins allowed to call the API
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=awsexam
POSTGRES_USER=awsexam
POSTGRES_PASSWORD=change-me-strong-db-password
# Full DSN is constructed by docker-compose; set explicitly if connecting externally
# DATABASE_URL=postgresql://awsexam:change-me@db:5432/awsexam

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# Separate DB index for Celery result backend
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET_KEY=change-me-to-a-long-random-hex-string
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# ── Celery ────────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/0
# Task time limit in seconds
CELERY_TASK_SOFT_TIME_LIMIT=300
CELERY_TASK_TIME_LIMIT=600

# ── Email ─────────────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USE_TLS=1
EMAIL_HOST_USER=noreply@example.com
EMAIL_HOST_PASSWORD=change-me-smtp-password
DEFAULT_FROM_EMAIL=noreply@example.com

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80
NGINX_HTTPS_PORT=443

# ── Frontend (Vite build-time vars — prefixed VITE_) ──────────────────────────
VITE_API_BASE_URL=https://myapp.com/api
VITE_APP_TITLE=AWS Exam App

# ── AWS (if using S3/SES/etc.) ────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_REGION_NAME=ap-southeast-1
